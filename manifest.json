{
  "manifest_version": 3,
  "name": "Live Translate cho tab (Gemini)",
  "version": "1.3.0",
  "description": "Click 1 lần để dịch audio của tab hiện tại sang tiếng Việt (hoặc ngôn ngữ khác) theo thời gian thực bằng Gemini 3.5 Live Translate.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bắt đầu / Dừng dịch tab này",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
